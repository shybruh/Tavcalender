# Copy to .env on the server and fill in. Keep it private and the same across updates.
#
# Generate the push keys with:   npx web-push generate-vapid-keys
# Generate the two secrets with: openssl rand -hex 24
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contact address push services can reach you at
VAPID_SUBJECT=mailto:you@example.com
# shared between PocketBase and the push service
PUSH_SECRET=
# shared between PocketBase and the Discord bot
BOT_SECRET=
# timezone for times in notifications and the Discord bot, e.g. Europe/London
TZ=UTC
# recommended on a new install: only this email can become the first admin
# (leave empty and the very first person to sign up becomes admin)
ADMIN_EMAIL=

# local development only (docker-compose sets these itself)
PUSH_URL=http://127.0.0.1:8091/send
BOT_URL=http://127.0.0.1:8092
APP_URL=http://localhost:8090
