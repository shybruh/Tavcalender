# Copy to .env and fill in. Generate VAPID keys with:
#   cd push && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# any long random string, shared between PocketBase and the push service
PUSH_SECRET=
# where PocketBase sends pushes (docker-compose overrides this)
PUSH_URL=http://127.0.0.1:8091/send
# timezone used for times in notification text, e.g. Europe/London
TZ=UTC
